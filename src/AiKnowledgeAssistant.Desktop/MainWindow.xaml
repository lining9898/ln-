<Window x:Class="AiKnowledgeAssistant.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:AiKnowledgeAssistant.Desktop.UI"
    Title="AI 知识库助手" Width="1120" Height="760" MinWidth="800" MinHeight="600"
    WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="14"
    Language="zh-CN" Background="#F5F7FA">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="192" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,24">
                <TextBlock DockPanel.Dock="Top" Text="AI 知识库助手" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,28" />
                <TextBlock DockPanel.Dock="Bottom" Text="本地资料 · 有据可查" FontSize="12" Foreground="#596779" Margin="0,20,0,0" />
                <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                    BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="主导航">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,14" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="32,24">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,12,0">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource PagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="AI问答">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="AI问答" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="选择知识库" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding KnowledgeBases.Items}"
                        SelectedItem="{Binding KnowledgeBases.Selected, Mode=TwoWay}"
                        DisplayMemberPath="Name" MinHeight="36" Margin="0,0,0,12"
                        AutomationProperties.Name="AI问答目标知识库" />
                    <StackPanel DataContext="{Binding Ai}">
                        <TextBlock Text="{Binding KeyStatus}" Foreground="#596779" Margin="0,0,0,12" />
                        <TextBlock Text="请输入你的问题" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" MinHeight="84"
                                AcceptsReturn="True" TextWrapping="Wrap" Padding="8"
                                AutomationProperties.Name="AI问题输入框" />
                            <Button Grid.Column="1" Content="发送" Command="{Binding AskCommand}" Margin="12,0,0,0"
                                VerticalAlignment="Bottom" />
                        </Grid>
                        <TextBlock Text="{Binding Message}" Margin="0,12,0,12" Foreground="#596779" />
                        <TextBox Text="{Binding Answer, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                            AcceptsReturn="True" MinHeight="180" Padding="12" VerticalScrollBarVisibility="Auto"
                            AutomationProperties.Name="AI回答" />
                        <TextBlock Text="引用来源" FontWeight="SemiBold" Margin="0,16,0,8" />
                        <ListBox ItemsSource="{Binding Citations}" BorderThickness="0" Background="Transparent"
                            AutomationProperties.Name="AI引用来源">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Position}" Foreground="#596779" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource PagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="知识库">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="知识库" Style="{StaticResource PageTitle}" />
                    <StackPanel DataContext="{Binding KnowledgeBases}">
                        <WrapPanel Margin="0,0,0,16">
                            <Button Content="＋ 新建知识库" Command="{Binding CreateCommand}" Margin="0,0,12,8" />
                            <Button Content="重命名" Command="{Binding RenameCommand}" Margin="0,0,12,8" />
                            <Button Content="删除" Command="{Binding DeleteCommand}" Margin="0,0,12,8" />
                            <Button Content="刷新" Command="{Binding RefreshCommand}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="我的知识库" FontSize="18" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding Summary}" Foreground="#596779" Margin="0,0,0,12" />
                        <Border Background="#EDF2F7" Padding="24" CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="还没有知识库" FontSize="20" />
                                <TextBlock Text="点击“新建知识库”，按公司资料、项目文件或个人资料分别管理。" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                            BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                            AutomationProperties.Name="知识库列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="选择后查看资料" Foreground="#596779" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <ui:DocumentsPanel DataContext="{Binding Documents}" Margin="0,16,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource PagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="文档搜索">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="文档搜索" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="搜索当前选择的知识库资料" Margin="0,0,0,12" />
                    <ComboBox ItemsSource="{Binding KnowledgeBases.Items}"
                        SelectedItem="{Binding KnowledgeBases.Selected, Mode=TwoWay}"
                        DisplayMemberPath="Name" MinHeight="36" Margin="0,0,0,12"
                        AutomationProperties.Name="搜索目标知识库" />
                    <StackPanel DataContext="{Binding Search}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="8"
                                AutomationProperties.Name="文档搜索词" />
                            <Button Grid.Column="1" Content="搜索" Command="{Binding SearchCommand}" Margin="12,0,0,0" />
                            <Button Grid.Column="2" Content="重建索引" Command="{Binding RebuildCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding Message}" Margin="0,12,0,12" Foreground="#596779" />
                        <Button Content="打开来源" Command="{Binding OpenSourceCommand}" Margin="0,0,0,12"
                            HorizontalAlignment="Left" />
                        <Border BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SourceTitle}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{Binding SourcePosition}" Foreground="#596779" Margin="0,5,0,0" />
                                <TextBox Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                    Background="Transparent" Foreground="#596779" Margin="0,3,0,8" />
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding JumpPage, UpdateSourceTrigger=PropertyChanged}" Width="64" Padding="6"
                                        AutomationProperties.Name="来源页码" />
                                    <Button Content="跳转" Command="{Binding JumpPageCommand}" Margin="8,0,8,0" />
                                    <Button Content="下一页" Command="{Binding NextPageCommand}" />
                                </WrapPanel>
                                <TextBox Text="{Binding SourceText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                    AcceptsReturn="True" MinHeight="120" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                            BorderThickness="0" Background="Transparent"
                            AutomationProperties.Name="文档搜索结果">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding Position}" Foreground="#596779" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding Source}" Foreground="#596779" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,9,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource PagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="文件管理">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="文件管理" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="选择知识库" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding KnowledgeBases.Items}"
                        SelectedItem="{Binding KnowledgeBases.Selected, Mode=TwoWay}"
                        DisplayMemberPath="Name" MinHeight="36" Margin="0,0,0,16"
                        AutomationProperties.Name="文件管理目标知识库" />
                    <ui:DocumentsPanel DataContext="{Binding Documents}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource PagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPage}" Value="设置">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="本地数据" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="您的知识库文件保存在本机。" Margin="0,12,0,8" />
                    <TextBox Text="{Binding DataRoot, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="12"
                        AutomationProperties.Name="本地数据目录" />
                    <TextBlock Text="软件程序与用户数据分开保存，升级不应删除知识库。" Margin="0,8,0,24" />
                    <TextBlock Text="AI 服务" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel DataContext="{Binding Ai}" Margin="0,12,0,0">
                        <TextBlock Text="{Binding KeyStatus}" Foreground="#596779" Margin="0,0,0,8" />
                        <TextBox Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}" MinHeight="36"
                            Padding="8" AutomationProperties.Name="DeepSeek API Key 输入框" />
                        <WrapPanel Margin="0,10,0,8">
                            <Button Content="保存 Key" Margin="0,0,8,0"
                                Command="{Binding SaveKeyCommand}" />
                            <Button Content="清除 Key" Command="{Binding ClearKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="测试连接" Command="{Binding TestConnectionCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Message}" Margin="0,8,0,0" Foreground="#596779" />
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="您的知识库文件保存在本机。" Foreground="#596779" Margin="0,16,0,0" />
        </Grid>
    </Grid>
</Window>
