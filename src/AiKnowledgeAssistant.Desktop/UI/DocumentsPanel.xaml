<UserControl x:Class="AiKnowledgeAssistant.Desktop.UI.DocumentsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="zh-CN" FontFamily="Microsoft YaHei UI" FontSize="14"
    AllowDrop="True" DragOver="FilesDragOver" Drop="FilesDrop">
    <Border Background="#FFFFFF" BorderBrush="#D9E1EA" BorderThickness="1" CornerRadius="6" Padding="16">
        <StackPanel>
            <TextBlock Text="{Binding SelectedKnowledgeBaseName, StringFormat=当前知识库：{0}}"
                FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
            <WrapPanel Margin="0,0,0,12">
                <Button Content="添加资料" Click="ChooseFilesClick" IsEnabled="{Binding CanImport}" Margin="0,0,12,0" />
                <TextBlock Text="支持 PDF、DOCX、TXT、MD；也可将文件拖到此区域。"
                    VerticalAlignment="Center" Foreground="#596779" />
            </WrapPanel>
            <TextBlock Text="文件会复制到本机的受管理目录；当前尚未解析或建立索引。"
                Foreground="#596779" Margin="0,0,0,12" />
            <TextBlock Text="{Binding ImportSummary}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding ImportResults}" Margin="0,0,0,12" />
            <TextBlock Text="请先选择知识库。" Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasKnowledgeBase}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ListView ItemsSource="{Binding Items}" MinHeight="100" MaxHeight="320"
                AutomationProperties.Name="当前知识库文件列表">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="文件名" DisplayMemberBinding="{Binding Name}" Width="210" />
                        <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Type}" Width="65" />
                        <GridViewColumn Header="大小" DisplayMemberBinding="{Binding Size}" Width="85" />
                        <GridViewColumn Header="导入时间" DisplayMemberBinding="{Binding ImportedAt}" Width="135" />
                        <GridViewColumn Header="解析状态" DisplayMemberBinding="{Binding ParseStatus}" Width="80" />
                        <GridViewColumn Header="索引状态" DisplayMemberBinding="{Binding IndexStatus}" Width="80" />
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
