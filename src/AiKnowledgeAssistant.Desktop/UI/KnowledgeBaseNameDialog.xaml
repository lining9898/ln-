<Window x:Class="AiKnowledgeAssistant.Desktop.UI.KnowledgeBaseNameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="460" Height="290" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="14" Language="zh-CN">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="知识库名称（最多 80 个字符）" Margin="0,0,0,12" />
        <TextBox x:Name="NameInput" Grid.Row="1" MinHeight="36" Padding="8"
            AutomationProperties.Name="知识库名称" />
        <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#B42318" Margin="0,12,0,12"
            AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="80" Margin="0,0,12,0" />
            <Button Content="保存" IsDefault="True" MinWidth="80" Click="SaveClick" />
        </StackPanel>
    </Grid>
</Window>
